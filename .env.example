# --- Database (PostgreSQL: Neon, Supabase, Vercel Postgres, or local) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Required behind proxies / outside Vercel. Vercel sets this automatically.
# AUTH_TRUST_HOST=true

# GitHub OAuth: https://github.com/settings/developers
# Callback URL: {APP_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Callback URL: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (password reset). Without a key, reset links are logged to the server console. ---
RESEND_API_KEY=""
EMAIL_FROM="Nexus <onboarding@resend.dev>"

# --- Avatar uploads (Vercel Blob). Create a Blob store in the Vercel dashboard. ---
BLOB_READ_WRITE_TOKEN=""

# --- Job search ---
# Claude drafts fit analysis, cover letters and screening answers. https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Adzuna job aggregator (free key): https://developer.adzuna.com
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
