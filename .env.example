# --- Database (PostgreSQL: Neon, Supabase, Vercel Postgres, or local) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus?schema=public"
# Non-pooled URL for migrations (on Supabase: the session pooler, port 5432). Locally the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nexus?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Required behind proxies / outside Vercel. Vercel sets this automatically.
# AUTH_TRUST_HOST=true

# GitHub OAuth: https://github.com/settings/developers
# Callback URL: {APP_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Callback URL: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (password reset, daily digest). Configure ONE of the options below. ---
# Locally, with neither set, emails are printed to the terminal instead of sent.
# Option A, SMTP (free): Gmail with an App Password (myaccount.google.com/apppasswords, needs
# 2-Step Verification): host smtp.gmail.com, port 465, user = your Gmail, pass = the 16-letter app password.
# Or Brevo (free, 300/day): host smtp-relay.brevo.com, port 587, with your Brevo SMTP login/key.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Option B, Resend API (needs a verified domain to email anyone besides yourself)
RESEND_API_KEY=""
# Sender shown to recipients (for Gmail, use your Gmail address)
EMAIL_FROM=""

# --- Avatar uploads (Vercel Blob). Create a Blob store in the Vercel dashboard. ---
BLOB_READ_WRITE_TOKEN=""

# --- Job search ---
# Claude drafts fit analysis, cover letters and screening answers. https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Adzuna job aggregator (free key): https://developer.adzuna.com
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# Comma-separated emails allowed to use Claude on a public deployment (others get every other feature).
AI_OWNER_EMAILS=""
# Protects the daily digest job (/api/cron/daily). Any long random string: openssl rand -hex 32
CRON_SECRET=""
