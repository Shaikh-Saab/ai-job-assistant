{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "sin1"
  ],
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npx prisma migrate deploy && npm run build",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 3 * * *"
    }
  ]
}
